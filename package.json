{
  "name": "dsh-plugin-cells-alive",
  "version": "0.3.1",
  "description": "First we check the cells. Then we check on you. Human-centered life-science companion plugin with warm Ethics-of-Care holding, milestone focus, Clean Breakpoint, and 0% manuscript leakage.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "life-sciences",
    "bioinformatics",
    "ethics-of-care",
    "research-companion",
    "anti-sycophancy"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./templates/*.example": "./templates/*.example",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "lib",
    "src",
    "skills",
    "core",
    "rules",
    "output-styles",
    "adapters",
    "templates",
    "community",
    "examples",
    "docs",
    "plugin.json",
    ".claude-plugin",
    "CONTRIBUTING.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*"
  },
  "author": "Zhuocheng Yao (@Spark-xY6)",
  "contributors": [
    {
      "name": "Zhuocheng Yao",
      "url": "https://github.com/Spark-xY6"
    },
    {
      "name": "Xuehua Zhao",
      "url": "https://github.com/snowflakee685-commits"
    }
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  }
}
